# Copy this file to .env.otel (which is gitignored) and paste the real token.
# split_share_core/telemetry.py reads it at startup; shell variables take precedence.
#
# Bluebox: Setup page -> Reveal token. The token starts with dt0s16.
# Use a literal space between Bearer and the token, not %20.

OTEL_EXPORTER_OTLP_ENDPOINT=https://njh16107.live.dynatrace.com/api/v2/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer dt0s16.PASTE_TOKEN_HERE

# Do NOT set OTEL_SERVICE_NAME here. Both the Django app and the coupon service
# read this file; each already defaults to its own name (split-share-web,
# split-share-coupons). Setting it here makes them report as one service.
